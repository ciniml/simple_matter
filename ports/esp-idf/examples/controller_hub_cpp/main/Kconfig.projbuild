menu "controller_hub_cpp configuration"

    config SM_WIFI_SSID
        string "WiFi SSID"
        default "my-ssid"
        help
            コントローラハブが接続する WiFi の SSID。

    config SM_WIFI_PASS
        string "WiFi password"
        default "my-password"
        help
            WiFi パスワード。

    config SM_TARGET_NODE_ID
        hex "Target node id (operational NodeId)"
        default 0xAABBCCDD
        help
            コミッショニングして管理する固定ノードの運用 NodeId。

    config SM_TARGET_PASSCODE
        int "Target passcode"
        default 20202021
        help
            対象デバイスの PASE パスコード(QR / ラベル由来)。

    config SM_TARGET_IP
        string "Target device IPv4 (on-network PASE)"
        default "192.168.2.129"
        help
            UDP 直接 PASE の宛先(対象デバイスの運用 IPv4)。

    config SM_TARGET_PORT
        int "Target device Matter UDP port"
        default 5540

    config SM_HUB_BLE_PAIR
        bool "BLE pairing mode (pairing ble-wifi via NimBLE central)"
        default n
        help
            有効にすると、UDP 直接 PASE の代わりに BLE(BTP central)で対象デバイスを
            コミッショニングする(F7b、docs/design/c-ffi-shim.md §11.4)。scan で
            discriminator を照合 → connect → BLE 上で PASE→AddNOC→AddWiFiNetwork→
            ConnectNetwork → BLE 切断 → 運用 mDNS 解決 → CASE over UDP → toggle。
            プロビジョンする WiFi 資格情報は SM_WIFI_SSID/SM_WIFI_PASS を流用する
            (ハブ自身の接続先 = デバイスの接続先 = 同一 AP)。

    config SM_TARGET_DISCRIMINATOR
        int "Target device discriminator (BLE scan match, 12bit)"
        default 3840
        depends on SM_HUB_BLE_PAIR

endmenu
