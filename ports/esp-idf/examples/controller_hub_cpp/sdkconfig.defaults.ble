# BLE pairing モード(pairing ble-wifi via NimBLE central)= F7b。
# docs/design/c-ffi-shim.md §11.4。明示合成で指定する:
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.ble"
# 既定(この構成を指定しない)は F7a の UDP 直接 PASE 路線(BT 無効・回帰維持)。

# Bluetooth LE + NimBLE ホスト(central/observer。scan → connect → GATT client)。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# WiFi/BLE 同時運用(coex)。BLE でコミッショニング → WiFi で運用 UDP へ handoff。
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# BLE pairing モードを有効化(main.cpp の分岐)。
CONFIG_SM_HUB_BLE_PAIR=y
