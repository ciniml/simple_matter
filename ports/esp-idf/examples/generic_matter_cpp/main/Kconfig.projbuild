menu "simple-matter generic_matter example"

    choice SM_NETWORK_TYPE
        prompt "Operational network transport"
        default SM_NETWORK_WIFI
        help
            プリセット NetworkCommissioning の種別(docs/design/c-ffi-shim.md §10)。
            wifi = pairing ble-wifi(既定)、thread = pairing ble-thread(esp_openthread)。
            択一。thread は ESP32-C6 の 802.15.4 + BLE coex を使う。

        config SM_NETWORK_WIFI
            bool "WiFi (pairing ble-wifi)"

        config SM_NETWORK_THREAD
            bool "Thread (pairing ble-thread, esp_openthread)"
            depends on IDF_TARGET_ESP32C6
    endchoice

    config SM_WIFI_SSID
        string "WiFi SSID"
        default "my-ssid"
        depends on SM_NETWORK_WIFI
        help
            接続先 WiFi の SSID。ビルドを通すためのプレースホルダ。実機では
            menuconfig / sdkconfig.local で上書きする(秘密は default に書かない)。

    config SM_WIFI_PASSWORD
        string "WiFi password"
        default "my-password"
        depends on SM_NETWORK_WIFI
        help
            WiFi パスフレーズ(WPA2-PSK)。プレースホルダ。

    config SM_DEFAULT_GPIO
        int "Default gpio_out pin (used when NVS smgen/bind is unset)"
        default 48 if IDF_TARGET_ESP32S3
        default 7
        help
            NVS に binding TLV(smgen/bind)が無いときの既定バインディング
            「EP1 OnOff -> gpio_out」のピン番号。既定は M5 NanoC6 の GPIO7
            (ESP32-S3 は DevKitC の RGB LED = GPIO48)。運用では cfg-bind で
            上書きする(再ビルド不要)。

    config SM_SCRIPT_PARTITION
        string "Script partition label"
        default "smscript"
        help
            スクリプト(WASM)格納用 raw パーティションのラベル。2 スロット構成で
            各スロット先頭 16B が "SMWS" ヘッダ(docs/design/generic-firmware.md §9.3)。

    config SM_SCRIPT_ENABLE
        bool "Enable WASM scripting (WAMR)"
        default y
        help
            WASM(WAMR)スクリプト VM を組み込む(§9.3 / Phase C)。n にすると WAMR も
            静的ヒーププールもリンクされず、Phase B と同じフットプリントに戻る。
            スクリプトイメージが無いデバイスは y のままでも従来どおり動作する
            (フックは全て no-op)。

    config SM_SCRIPT_POOL_KB
        int "WAMR heap pool size (KB)"
        default 80
        depends on SM_SCRIPT_ENABLE
        help
            WAMR に渡すヒーププール。線形メモリ(既定 64KB = 1 page)+ モジュール +
            実行スタックが全てここから確保される(WAMR には malloc を渡さない =
            スクリプトがシステムヒープを食い潰せない)。

    config SM_SCRIPT_POOL_STATIC
        bool "Reserve the WAMR pool statically (BSS)"
        default n
        depends on SM_SCRIPT_ENABLE
        help
            y = プールを .bss に静的確保する(確保失敗が起き得ない代わりに、スクリプトを
            積んでいないデバイスでも RAM を占有する)。n(既定)= スクリプトイメージが
            見つかったときだけ内部 RAM から 1 度だけ確保する(失敗したら解放して
            スクリプト無しで起動)。C6 の WiFi+BLE+Matter 構成では 96KB の常時占有が
            ヒープを圧迫するため既定は n。

    config SM_SCRIPT_MAX_KB
        int "Max script image size (KB)"
        default 24
        depends on SM_SCRIPT_ENABLE
        help
            パーティションから読み出す .wasm の上限。読み出しバッファはロード時だけ
            確保して、プールへ複製したら解放する。

    config SM_SCRIPT_STACK_KB
        int "WASM execution stack (KB)"
        default 8
        depends on SM_SCRIPT_ENABLE

    config SM_SCRIPT_BUDGET_MS
        int "Per-hook wall clock budget (ms)"
        default 50
        depends on SM_SCRIPT_ENABLE
        help
            1 フックあたりの壁時計上限。超過すると esp_timer コールバックから
            wasm_runtime_terminate で trap を上げてフックを打ち切る(§9.3)。
            0 = 無制限(非推奨)。

    config SM_SCRIPTSTORE_ENABLE
        bool "Enable the ScriptStore vendor cluster (script OTA)"
        default y
        depends on SM_SCRIPT_ENABLE
        help
            vendor クラスタ ScriptStore(0xFFF1FC01)を CustomCluster として登録し、
            Begin/Data/Commit/Abort でスクリプトイメージを非 active スロットへ
            転送できるようにする(§9.4 / Phase D)。Commit で CRC 検証 → ヘッダ書き込み
            → VM 再ロード(失敗時は旧スロットへロールバック)。
            認可はシム既定(invoke = Operate)。

    config SM_SCRIPTSTORE_EP
        int "Endpoint hosting the ScriptStore cluster"
        default 1
        depends on SM_SCRIPTSTORE_ENABLE
        help
            ScriptStore を載せるエンドポイント。既定 1(合成構成に必ず存在する EP へ
            相乗りする)。合成 EP へカスタムクラスタを足す形になるので、Descriptor の
            ServerList はシムが自動でマージする(F4b)。

    config SM_FACTORY_DATA
        bool "Use factory data partition (esp-matter-mfg-tool compatible)"
        default n
        help
            esp-matter-mfg-tool 生成の factory NVS パーティション(chip-factory
            namespace)から DAC/PAI/DAC 鍵・SPAKE2+ verifier・discriminator・VID/PID を
            読み、sm_config_t に供給する(docs/design/factory-data.md §5)。
            パーティション未 flash / 読み取り失敗時は開発用の dev 定数にフォールバックする。

    config SM_FACTORY_PARTITION
        string "Factory data partition label"
        default "nvs_factory"
        depends on SM_FACTORY_DATA
        help
            factory データ NVS パーティションのラベル(partitions.csv のエントリ名)。

    config SM_ENABLE_BLE
        bool "Enable BLE (NimBLE) commissioning"
        default y if IDF_TARGET_ESP32C6
        default y if SM_NETWORK_THREAD
        default n
        help
            BLE(NimBLE)給餌によるコミッショニング(pairing ble-wifi / ble-thread)を
            有効にする(docs/design/c-ffi-shim.md §9・§10)。有効時は起動時 WiFi join を
            止め、ConnectNetwork 駆動でプロビジョンする。ESP32-S3 は既定 n。

endmenu
