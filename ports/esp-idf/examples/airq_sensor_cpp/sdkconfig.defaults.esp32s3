# ESP32-S3 専用の既定(sdkconfig.defaults に加えて IDF が自動連結する)。
# AirQ は WiFi + BLE(NimBLE)coex 構成。BLE コミッショニング(pairing ble-wifi)。

# example の Kconfig: BLE を有効化する(S3 でも既定 y だが明示)。
CONFIG_SM_ENABLE_BLE=y

# Bluetooth LE + NimBLE ホスト(peripheral のみ = RAM 削減)。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# WiFi/BLE 同時運用(coex)。commissioning 中は BLE、その後 WiFi 運用へ遷移。
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# コンソールを USB-Serial-JTAG に出す(M5 AirQ の USB ポート)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- 省 RAM: WiFi バッファ削減(内部 RAM 断片化緩和、Matter タスクの連続スタック確保用) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
# NimBLE ACL バッファ。ATT MTU=247 → BTP は 244B の indication を送るため、ACL バッファは
# 単一パケットに収まる 251(BLE 標準の最大 ACL データ長)にする。128 に削ると 244B 送信時に
# NimBLE の host 側フラグメント分割(mem_split_frag)を通り、LoadProhibited でクラッシュする。
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
# 255 = IDF 既定(HCI ACL データ部の最大、4B ヘッダ含まず)。251 にすると相手(iPhone/Echo、DLE 251)からの
# 244B 値の Write(L2CAP 4 + ATT 247 = ACL 251B)がホストに届かず、AddTrustedRootCertificate 以降が
# 失われて BLE コミッショニングが CSR 後に停止する(2026-09-27)。128 では送信側で mbuf 分割クラッシュ。
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=255
CONFIG_LWIP_MLDV6_TMR_INTERVAL=5
# NimBLE の自動「Reattempt advertising」は ble_gap_adv_set_fields で保存した fields で広告を再開する。
# 本ポートは ble_gap_adv_set_data(生データ)を使うため空の広告になり、デバイスが発見不能になる。
# 接続確立失敗時の再広告は gap_event_cb(DISCONNECT)で自前で行うので無効化する。
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
