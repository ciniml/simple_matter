# onoff_light_cpp 既定設定(ターゲット非依存: esp32c6 / esp32s3 両対応)。
# ターゲットは `idf.py set-target <esp32c6|esp32s3>` で選ぶ(CONFIG_IDF_TARGET は
# ここに固定しない。F4a で S3 対応のため非依存化)。

# カスタムパーティション: 既定 1MB では app が収まらないため拡張(partitions.csv)。
# 4MB flash(NanoC6)。2.5MB app パーティション(Thread 構成の openthread 分。§10.2)を
# 収めるため既定 2MB から拡張する(WiFi 構成でも同じ = 空きが増えるだけ)。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# メインタスクは軽い(pump は別タスク)。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# lwIP: IPv6 + マルチキャスト(mDNS の v4 IGMP / v6 MLD join)を有効化。
# 注: IPv4 IGMP は ESP-IDF lwIP で常時有効(専用 Kconfig 無し)。
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# SO_REUSEADDR / SO_REUSEPORT を使う。
CONFIG_LWIP_SO_REUSE=y
# select() を使うのでソケット数に余裕を持たせる。
CONFIG_LWIP_MAX_SOCKETS=10

# C++: 例外・RTTI は不要(コード量/バイナリ削減)。C++17 は IDF v5.4 既定。
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
