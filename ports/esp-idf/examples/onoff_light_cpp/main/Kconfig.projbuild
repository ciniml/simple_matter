menu "simple-matter onoff_light example"

    choice SM_NETWORK_TYPE
        prompt "Operational network transport"
        default SM_NETWORK_WIFI
        help
            プリセット NetworkCommissioning の種別(docs/design/c-ffi-shim.md §10)。
            wifi = pairing ble-wifi(既定)、thread = pairing ble-thread(esp_openthread)。
            択一。thread は ESP32-C6 の 802.15.4 + BLE coex を使う。

        config SM_NETWORK_WIFI
            bool "WiFi (pairing ble-wifi)"

        config SM_NETWORK_THREAD
            bool "Thread (pairing ble-thread, esp_openthread)"
            depends on IDF_TARGET_ESP32C6
    endchoice

    config SM_WIFI_SSID
        string "WiFi SSID"
        default "my-ssid"
        depends on SM_NETWORK_WIFI
        help
            接続先 WiFi の SSID。ビルドを通すためのプレースホルダ。実機では
            menuconfig で上書きする。

    config SM_WIFI_PASSWORD
        string "WiFi password"
        default "my-password"
        depends on SM_NETWORK_WIFI
        help
            WiFi パスフレーズ(WPA2-PSK)。

    config SM_LED_GPIO
        int "OnOff LED GPIO"
        default 48 if IDF_TARGET_ESP32S3
        default 7
        help
            OnOff 状態を反映する LED の GPIO 番号。既定は M5 NanoC6 の GPIO7
            (ESP32-S3 は DevKitC の RGB LED = GPIO48)。

    config SM_BUTTON_GPIO
        int "Local toggle button GPIO (-1 to disable)"
        default -1 if IDF_TARGET_ESP32S3
        default 9
        help
            本体ボタンで OnOff をローカルトグルするための GPIO 番号
            (docs/design/p4-thread-controller.md §15)。既定は M5 NanoC6 の
            BOOT ボタン = GPIO9(active-low、内部プルアップ)。-1 で無効。
            ESP32-S3 DevKitC は既定 -1(ボタンなし想定)。

    config SM_FACTORY_DATA
        bool "Use factory data partition (esp-matter-mfg-tool compatible)"
        default n
        help
            esp-matter-mfg-tool 生成の factory NVS パーティション(chip-factory
            namespace)から DAC/PAI/DAC 鍵・SPAKE2+ verifier・discriminator・VID/PID を
            読み、sm_config_t に供給する(docs/design/factory-data.md §5)。
            パーティションラベルは SM_FACTORY_PARTITION。パーティション未 flash /
            読み取り失敗時は開発用の dev 定数にフォールバックする(後方互換)。
            CD(cert-dclrn)が factory に無い場合は埋め込み dev CD を使う。

    config SM_FACTORY_PARTITION
        string "Factory data partition label"
        default "nvs_factory"
        depends on SM_FACTORY_DATA
        help
            factory データ NVS パーティションのラベル(partitions.csv のエントリ名)。
            esp-matter-mfg-tool 生成の *-partition.bin をこのパーティションに flash する。

    config SM_ENABLE_BLE
        bool "Enable BLE (NimBLE) commissioning"
        default y if IDF_TARGET_ESP32C6
        default y if SM_NETWORK_THREAD
        default n
        help
            BLE(NimBLE)給餌によるコミッショニング(pairing ble-wifi / ble-thread)を
            有効にする(docs/design/c-ffi-shim.md §9・§10)。有効時は起動時 WiFi join を
            止め、ConnectNetwork 駆動でプロビジョンする。Thread 構成では必須
            (ble-thread のコミッショニング経路)なので既定 y。ESP32-S3 は既定 n
            (従来の UDP 直接 PASE のみ)。

endmenu
